our lines: length, uppercase, first character, last character.", "sol": "s = input()\nprint(len(s))\nprint(s.upper())\nprint(s[0])\nprint(s[-1])", "tests": [["programming", "11\nPROGRAMMING\np\ng"], ["Python", "6\nPYTHON\nP\nn"], ["level", "5\nLEVEL\nl\nl"]]}, {"t": "String Slicing", "d": "Read a string. On the first line print its first three characters. On the second line print the string reversed. Use slicing.", "i": "One line: a string (at least 3 characters).", "o": "Two lines: first three characters, reversed string.", "sol": "s = input()\nprint(s[:3])\nprint(s[::-1])", "tests": [["Python Programming", "Pyt\ngnimmargorP nohtyP"], ["abcdef", "abc\nfedcba"], ["India", "Ind\naidnI"]]}, {"t": "List Basics", "d": "Read three integers and store them in a list. Print the list, then the largest element, the smallest element and the sum of all elements, each on a new line.", "i": "Three lines: one integer on each line.", "o": "Four lines: the list, max, min, sum.", "sol": "a = int(input())\nb = int(input())\nc = int(input())\nnums = [a, b, c]\nprint(nums)\nprint(max(nums))\nprint(min(nums))\nprint(sum(nums))", "tests": [["5\n2\n9", "[5, 2, 9]\n9\n2\n16"], ["10\n10\n3", "[10, 10, 3]\n10\n3\n23"], ["-4\n8\n1", "[-4, 8, 1]\n8\n-4\n5"]]}, {"t": "List Methods", "d": "Read three integers and store them in a list. Append 100 to the end, insert 0 at index 0, sort the list in ascending order and print the list.", "i": "Three lines: one integer on each line.", "o": "One line: the final list.", "sol": "a = int(input())\nb = int(input())\nc = int(input())\nnums = [a, b, c]\nnums.append(100)\nnums.insert(0, 0)\nnums.sort()\nprint(nums)", "tests": [["5\n2\n9", "[0, 2, 5, 9, 100]"], ["30\n20\n10", "[0, 10, 20, 30, 100]"], ["1\n1\n1", "[0, 1, 1, 1, 100]"]]}, {"t": "List Slicing", "d": "Read four integers into a list called nums. Print three lines: the slice nums[1:3], the reversed list, and every second element starting from the first element.", "i": "Four lines: one integer on each line.", "o": "Three lines, each a list.", "sol": "nums = [int(input()), int(input()), int(input()), int(input())]\nprint(nums[1:3])\nprint(nums[::-1])\nprint(nums[::2])", "tests": [["1\n2\n3\n4", "[2, 3]\n[4, 3, 2, 1]\n[1, 3]"], ["10\n20\n30\n40", "[20, 30]\n[40, 30, 20, 10]\n[10, 30]"], ["7\n5\n3\n1", "[5, 3]\n[1, 3, 5, 7]\n[7, 3]"]]}, {"t": "Tuple Basics", "d": "Read a name, an age (integer) and a city. Create a tuple (name, age, city) and print the tuple.", "i": "Three lines: name, age, city.", "o": "One line: the tuple, for example ('Ravi', 21, 'Pune').", "sol": "name = input()\nage = int(input())\ncity = input()\nt = (name, age, city)\nprint(t)", "tests": [["Ravi\n21\nPune", "('Ravi', 21, 'Pune')"], ["Sneha\n19\nMumbai", "('Sneha', 19, 'Mumbai')"], ["Amit\n25\nNagpur", "('Amit', 25, 'Nagpur')"]]}, {"t": "Tuple Unpacking", "d": "Read a name, an age (integer) and a city. Store them in a tuple, unpack the tuple into three variables and print: <name> is <age> years old and lives in <city>", "i": "Three lines: name, age, city.", "o": "One line, for example: Ravi is 21 years old and lives in Pune", "sol": "t = (input(), int(input()), input())\nname, age, city = t\nprint(name, 'is', age, 'years old and lives in', city)", "tests": [["Ravi\n21\nPune", "Ravi is 21 years old and lives in Pune"], ["Sneha\n19\nMumbai", "Sneha is 19 years old and lives in Mumbai"], ["Amit\n25\nNagpur", "Amit is 25 years old and lives in Nagpur"]]}, {"t": "Tuple Methods", "d": "Read four integers and store them in a tuple t. Print four lines: len(t), the last element of t, how many times the first number appears in t (count), and the index of the second number (index).", "i": "Four lines: one integer on each line.", "o": "Four lines: length, last element, count, index.", "sol": "t = (int(input()), int(input()), int(input()), int(input()))\nprint(len(t))\nprint(t[-1])\nprint(t.count(t[0]))\nprint(t.index(t[1]))", "tests": [["10\n20\n30\n20", "4\n20\n1\n1"], ["5\n5\n7\n5", "4\n5\n3\n0"], ["1\n2\n3\n4", "4\n4\n1\n1"]]}, {"t": "List and Tuple Conversion", "d": "Read three integers and store them in a tuple. Convert it to a list, append 99 to the list and print the list. Then convert the list back to a tuple and print the tuple.", "i": "Three lines: one integer on each line.", "o": "Two lines: the list, then the tuple.", "sol": "t = (int(input()), int(input()), int(input()))\nl = list(t)\nl.append(99)\nprint(l)\nprint(tuple(l))", "tests": [["1\n2\n3", "[1, 2, 3, 99]\n(1, 2, 3, 99)"], ["10\n20\n30", "[10, 20, 30, 99]\n(10, 20, 30, 99)"], ["4\n5\n6", "[4, 5, 6, 99]\n(4, 5, 6, 99)"]]}, {"t": "Swap Two Values", "d": "Read two integers a and b. Swap their values using tuple unpacking (a, b = b, a) and print a on the first line and b on the second line.", "i": "Two lines: a, then b.", "o": "Two lines: a and b after swapping.", "sol": "a = int(input())\nb = int(input())\na, b = b, a\nprint(a)\nprint(b)", "tests": [["3\n8", "8\n3"], ["10\n-2", "-2\n10"], ["0\n9", "9\n0"]]}];
const $=id=>document.getElementById(id),esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const K='pybasics_test_en_v2',DUR=90*60*1000;
let S={name:'',start:0,ans:{},code:{},done:0,pr:null},timer=null,armed=false;
try{Object.assign(S,JSON.parse(localStorage.getItem(K)||'{}'))}catch(e){}
function save(){try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}}
function qh(q){var l=q.split("\n");return '<div>'+esc(l[0])+'</div>'+(l.length>1?'<pre>'+esc(l.slice(1).join("\n"))+'</pre>':'')}
function build(){
 $('mcq').innerHTML=Q.map(function(q,i){return '<div class="card"><span class="qn">Q'+(i+1)+'.</span> '+qh(q[0])+q[1].split('|').map(function(o,j){return '<label class="opt"><input type="radio" name="q'+i+'" value="'+j+'"'+(S.ans[i]===j?' checked':'')+' onchange="pick('+i+','+j+')"><span>'+esc(o)+'</span></label>'}).join('')+'</div>'}).join('');
 $('prac').innerHTML=P.map(function(p,i){var s=p.tests[0];return '<div class="card"><div><span class="qn">Problem '+(i+1)+': '+esc(p.t)+'</span> <span class="mu">(1 mark)</span></div><p>'+esc(p.d)+'</p><div class="io"><b>Input format:</b> '+esc(p.i)+'</div><div class="io"><b>Output format:</b> '+esc(p.o)+'</div><div class="sam"><div><b>Sample input</b><pre>'+esc(s[0])+'</pre></div><div><b>Sample output</b><pre>'+esc(s[1])+'</pre></div></div><textarea spellcheck="false" placeholder="# Write your Python code here" oninput="code('+i+',this.value)">'+esc(S.code[i]||'')+'</textarea><button class="g" onclick="runOne('+i+')">Run on sample input</button><div id="ro'+i+'"></div></div>'}).join('');
}
function pick(i,j){S.ans[i]=j;save();cnt()}
function code(i,v){S.code[i]=v;save()}
function cnt(){$('an').textContent=Object.keys(S.ans).length}
function begin(){var n=$('nm').value.trim();if(!n){$('nm').focus();return}S.name=n;S.start=Date.now();save();run()}
function run(){$('start').classList.add('hide');if(S.done){result();return}$('test').classList.remove('hide');build();cnt();tick();timer=setInterval(tick,1000)}
function tick(){var r=S.start+DUR-Date.now();if(r<=0){submit();return}var h=Math.floor(r/3600000),m=Math.floor(r%3600000/60000),s=Math.floor(r%60000/1000);
 $('tm').textContent=[h,m,s].map(function(x){return String(x).padStart(2,'0')}).join(':');$('tb').classList.toggle('low',r<600000)}
function trySubmit(){var left=Q.length-Object.keys(S.ans).length;if(!armed&&left>0){armed=true;$('sub').textContent=left+' MCQs unanswered. Press again to submit';return}submit()}
function submit(){clearInterval(timer);S.done=1;S.end=Date.now();save();$('test').classList.add('hide');result()}
/* code runner */
function rd(x){if(Sk.builtinFiles===undefined||Sk.builtinFiles["files"][x]===undefined)throw "File not found: '"+x+"'";return Sk.builtinFiles["files"][x]}
function runPy(code,inp){
 if(typeof Sk==='undefined')return Promise.resolve({out:'',err:'Code runner could not be loaded.',na:1});
 code=code.replace(/\binput\s*\(\s*(?:"[^"\n]*"|'[^'\n]*')\s*\)/g,"input()");
 var lines=inp?inp.split("\n"):[],out="";
 Sk.configure({output:function(t){out+=t},read:rd,inputfun:function(){return lines.length?lines.shift():""},__future__:Sk.python3,execLimit:3000});
 return Sk.misceval.asyncToPromise(function(){return Sk.importMainWithBody("<stdin>",false,code,true)}).then(function(){return{out:out}},function(e){return{out:out,err:e.toString()}});
}
const norm=s=>s.split("\n").map(function(l){return l.replace(/\s+$/,'')}).join("\n").replace(/\n+$/,'');
function runOne(i){var c=S.code[i]||'',el=$('ro'+i);if(!c.trim()){el.innerHTML='<div class="bad">Write some code first.</div>';return}el.innerHTML='<div class="mu">Running...</div>';
 runPy(c,P[i].tests[0][0]).then(function(r){var ok=!r.err&&norm(r.out)===norm(P[i].tests[0][1]);el.innerHTML='<div class="mu">Your output:</div><pre>'+esc(r.out||'(no output)')+'</pre>'+(r.err?'<div class="bad">Error: '+esc(r.err)+'</div>':ok?'<div class="ok">Matches the sample output.</div>':'<div class="bad">Does not match the sample output.</div>')})}
async function grade(){
 if(typeof Sk==='undefined'){S.pr='na';save();return}
 var pr={};
 for(var i=0;i<P.length;i++){var c=S.code[i]||'',res=[];
  for(var k=0;k<P[i].tests.length;k++){var t=P[i].tests[k];
   if(!c.trim()){res.push({ok:0,out:'',err:'No code submitted'});continue}
   var r=await runPy(c,t[0]);res.push({ok:(!r.err&&norm(r.out)===norm(t[1]))?1:0,out:r.out||'',err:r.err||''})}
  pr[i]=res}
 S.pr=pr;save()}
function result(){
 $('res').classList.remove('hide');
 if(!S.pr){$('res').innerHTML='<div class="card"><h1>Evaluating your code...</h1><div class="mu">Please wait a few seconds.</div></div>';grade().then(result);return}
 var sc=0,w=[];Q.forEach(function(q,i){if(S.ans[i]===q[2])sc++;else w.push(i)});
 var na=S.pr==='na',pm=0;if(!na)P.forEach(function(p,i){if(S.pr[i].every(function(x){return x.ok}))pm++});
 var tot=sc+pm,max=100+(na?0:15),pass=tot>=Math.ceil(max*.4),pc=Math.round(tot/max*100),used=Math.min(S.end||Date.now(),S.start+DUR)-S.start,att=Object.keys(S.ans).length;
 var h='<div class="card" style="text-align:center"><h1>Test Result</h1><div>'+esc(S.name)+'</div><div class="big '+(pass?'ok':'bad')+'">'+tot+' / '+max+'</div><div>'+pc+'% &middot; '+(pass?'<span class="ok">PASS</span>':'<span class="bad">FAIL</span>')+'</div>'
 +'<p>Part A (MCQ): <b>'+sc+' / 100</b> &nbsp;|&nbsp; Part B (Coding): <b>'+(na?'to be checked by teacher':pm+' / 15')+'</b></p>'
 +'<div class="mu">MCQ: '+sc+' correct, '+(att-sc)+' wrong, '+(Q.length-att)+' unanswered &middot; Time used: '+Math.floor(used/60000)+' min</div><button onclick="window.print()">Print / Save as PDF</button></div>';
 h+='<h2>Part A: Wrong and Unanswered Questions ('+w.length+')</h2>';
 if(!w.length)h+='<div class="card ok">All answers are correct!</div>';
 w.forEach(function(i){var q=Q[i],o=q[1].split('|');h+='<div class="card"><span class="qn">Q'+(i+1)+'.</span> '+qh(q[0])+'<div class="bad">Your answer: '+(S.ans[i]===undefined?'Not answered':'<code>'+esc(o[S.ans[i]])+'</code>')+'</div><div class="ok">Correct answer: <code>'+esc(o[q[2]])+'</code></div></div>'});
 h+='<h2>Part B: Coding Problems</h2>';
 P.forEach(function(p,i){var r=na?null:S.pr[i],good=r&&r.every(function(x){return x.ok}),n=r?r.filter(function(x){return x.ok}).length:0,f=r?r.findIndex(function(x){return!x.ok}):-1;
  h+='<div class="card"><span class="qn">Problem '+(i+1)+': '+esc(p.t)+'</span> '+(na?'':(good?'<span class="ok">&#10003; Correct (1/1)</span>':'<span class="bad">&#10007; '+n+'/'+r.length+' test cases passed (0/1)</span>'))+'<p>'+esc(p.d)+'</p><div class="mu">Your code:</div><pre>'+(S.code[i]&&S.code[i].trim()?esc(S.code[i]):'(not attempted)')+'</pre>';
  if(f>=0){var t=p.tests[f];h+='<div class="bad">Failed test case</div><div class="mu">Input:</div><pre>'+esc(t[0])+'</pre><div class="mu">Expected output:</div><pre>'+esc(t[1])+'</pre><div class="mu">Your output:</div><pre>'+esc(r[f].out||'(no output)')+'</pre>'+(r[f].err?'<div class="bad">Error: '+esc(r[f].err)+'</div>':'')}
  h+='<div class="ok">Model solution:</div><pre>'+esc(p.sol)+'</pre></div>'});
 h+='<button class="g" onclick="try{localStorage.removeItem(\''+K+'\')}catch(e){}location.reload()">Reset (for teacher)</button>';
 $('res').innerHTML=h;scrollTo(0,0)
}
if(S.start)run();
</script>
